# Per-machine config. Copy to host.conf (install.sh does it) and edit.
# This file is sourced LAST, so anything here overrides the shared config.
# Docs: https://wiki.hypr.land/Configuring/Monitors/

# ── Monitors ───────────────────────────────────────────────────────
# Sane default: every output at its preferred mode, laid out automatically.
monitor = , preferred, auto, 1

# `hyprctl monitors` lists names and available modes.
#
# The dual-screen layout on the laptop:
# monitor = HDMI-A-1, 2560x1440@60, 0x0, 1
# monitor = eDP-1,    preferred,    2560x0, 1

# ── Workspace → monitor pinning ────────────────────────────────────
# Without pinning, workspaces 1-10 land wherever you are. That is what you
# want on a single screen, so it is the default (i.e. nothing here).
#
# The dual-screen split: 1-10 on the laptop panel, 11-14 on the external.
# Keys are SUPER+1..0 and SUPER+A/S/D/G — see conf/binds.conf.
#
# workspace = 1,  monitor:eDP-1, persistent:true, default:true
# workspace = 2,  monitor:eDP-1, persistent:true
# workspace = 3,  monitor:eDP-1, persistent:true
# workspace = 4,  monitor:eDP-1, persistent:true
# workspace = 5,  monitor:eDP-1, persistent:true
# workspace = 6,  monitor:eDP-1, persistent:true
# workspace = 7,  monitor:eDP-1, persistent:true
# workspace = 8,  monitor:eDP-1, persistent:true
# workspace = 9,  monitor:eDP-1, persistent:true
# workspace = 10, monitor:eDP-1, persistent:true
# workspace = 11, monitor:HDMI-A-1, persistent:true, default:true
# workspace = 12, monitor:HDMI-A-1, persistent:true
# workspace = 13, monitor:HDMI-A-1, persistent:true
# workspace = 14, monitor:HDMI-A-1, persistent:true

# ── GPU / video decode ─────────────────────────────────────────────
# Hybrid Intel + NVIDIA laptop: VA-API goes through the Intel iGPU, because
# NVIDIA's VA-API is broken/absent there.
# env = LIBVA_DRIVER_NAME,iHD
# env = NVD_BACKEND,direct

# NVIDIA-primary machine instead — https://wiki.hypr.land/Nvidia/
# env = LIBVA_DRIVER_NAME,nvidia
# env = GBM_BACKEND,nvidia-drm
# env = __GLX_VENDOR_LIBRARY_NAME,nvidia
# env = __GL_VRR_ALLOWED,1

# conf/cursor.conf forces software cursors (needed on NVIDIA). On an
# Intel/AMD-only machine you can take the hardware ones back:
# cursor {
#     no_hardware_cursors = false
# }

# VM guest:
# env = WLR_RENDERER_ALLOW_SOFTWARE,1
